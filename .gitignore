# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Data files (raw 3M tweet dataset should not be committed to Git)
data/raw/*.csv
data/raw/*.zip
data/raw/*.tar.gz
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment variables & secrets
.env
*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Test & coverage caches
.pytest_cache/
.coverage
htmlcov/

# Results & temporary scratch
results/*.tmp
results/scratch/
!results/.gitkeep

# Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

